<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Reference template for the managed daemon LaunchAgent. The installed
     plist is generated by cli/install/service-macos.mjs with absolute payload
     paths and the fixed GUI PATH; this file documents the managed shape and
     is not read at runtime. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.external-subagent.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/&lt;npm-prefix&gt;/lib/node_modules/external-subagent/npm/native/darwin-arm64/external-subagentd</string>
        <string>--database</string>
        <string>&lt;home&gt;/Library/Application Support/external-subagent/external-subagent.sqlite3</string>
        <string>--socket</string>
        <string>&lt;home&gt;/Library/Application Support/external-subagent/external-subagent.sock</string>
        <string>--runtime</string>
        <string>/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs</string>
        <string>--diagnostic-log</string>
        <string>&lt;home&gt;/Library/Logs/external-subagent/daemon-error.log</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>&lt;home&gt;/Library/Logs/external-subagent/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>&lt;home&gt;/Library/Logs/external-subagent/daemon-error.log</string>
</dict>
</plist>
