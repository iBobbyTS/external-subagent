{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-subagent.invalid/schema/public-api.json",
  "title": "external-subagent MCP public API",
  "description": "The intentionally small external_subagent_* wire catalog.",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "const": ["external_subagent_cancel", "external_subagent_close", "external_subagent_list", "external_subagent_observe", "external_subagent_wait", "external_subagent_respond", "external_subagent_result", "external_subagent_send", "external_subagent_spawn", "external_subagent_status"]
    },
    "permission_mode": { "enum": ["build", "edit", "plan", "yolo"], "default": "build" },
    "subagent_status": {
      "type": "object",
      "required": ["subagent", "configured", "enabled", "spawn_supported", "permission_modes", "model_selection", "effort_selection", "local", "auth", "hi"],
      "properties": {
        "subagent": { "enum": ["zcode", "dsh", "codex"] },
        "configured": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "spawn_supported": { "type": "boolean" },
        "permission_modes": {
          "type": "array",
          "items": { "enum": ["build", "edit", "plan", "yolo"] },
          "uniqueItems": true
        },
        "model_selection": {
          "type": "object",
          "required": ["supported", "mode"],
          "properties": {
            "supported": { "type": "boolean" },
            "mode": { "enum": ["native_only", "catalog_token"] }
          },
          "additionalProperties": false
        },
        "effort_selection": {
          "type": "object",
          "description": "Reasoning-effort steering capability. codex admits only its closed set; zcode and dsh pass a bounded [a-z0-9_] token through to the runtime.",
          "required": ["supported", "mode"],
          "properties": {
            "supported": { "type": "boolean" },
            "mode": { "enum": ["closed_set", "passthrough_token"] }
          },
          "additionalProperties": false
        },
        "local": { "$ref": "#/properties/subagent_scope_status" },
        "auth": { "$ref": "#/properties/subagent_scope_status" },
        "hi": { "$ref": "#/properties/subagent_scope_status" }
      },
      "additionalProperties": false
    },
    "subagent_scope_status": {
      "type": "object",
      "description": "Readiness conclusion only. Probe evidence (scope paths, version, checked_at_ms, reason) stays on the daemon RPC view for the CLI diagnose owner.",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["READY", "DEGRADED", "UNAVAILABLE", "UNKNOWN"] }
      },
      "additionalProperties": false
    },
    "spawn": {
      "type": "object",
      "required": ["repository", "prompt"],
      "properties": {
        "subagent": { "type": "string", "minLength": 1, "description": "Subagent route key; omission uses configured default_subagent or returns subagent_required. Null is invalid; dsh production spawn remains gated." },
        "repository": { "type": "string", "minLength": 1 },
        "permission_mode": { "$ref": "#/properties/permission_mode", "description": "codex supports build/edit (workspace-write), plan (read-only), and yolo (danger-full-access), always with approvalPolicy=never." },
        "prompt": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1, "description": "Task model. dsh requires provider:model, split at the first colon (the model side may contain further colons; a missing colon or an empty side is rejected before any task). codex uses its own model id; zcode rejects model selection." },
        "effort": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[a-z0-9_]+$", "description": "Reasoning-effort token: 1..24 bytes of [a-z0-9_]. codex admits only low, medium, high or xhigh; zcode and dsh pass the bounded token through. Omission keeps the runtime default." },
        "write_manifest": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "codex requires an empty or omitted write_manifest; non-empty input returns codex_write_manifest_unsupported before task creation. plan requires an empty manifest for every subagent." }
      },
      "allOf": [
        { "if": { "required": ["subagent"], "properties": { "subagent": { "const": "codex" } } },
          "then": { "properties": { "write_manifest": { "maxItems": 0 } } } },
        { "if": { "required": ["permission_mode"], "properties": { "permission_mode": { "const": "plan" } } },
          "then": { "properties": { "write_manifest": { "maxItems": 0 } } } }
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "subagent": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "phase": { "type": ["string", "null"], "default": null },
        "outcome": { "type": ["string", "null"], "default": null },
        "cursor": { "type": ["string", "null"], "default": null },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
      },
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "description": "Wait returns early only for an actionable pending request (permission requests need allow/deny; user-input requests carry the full embedded question and need answer with non-empty content) or a terminal result; ordinary progress, message receipts, already-responded and unsupported requests never wake it. The pending_requests output projection is capped at 100 actionable records, while the wake decision scans the full pending set. activity carries the latest text tail, a 200-char verified reasoning tail, tool calls started in the last 60 seconds, and telemetry status.",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
        "wait_time": { "type": "integer", "minimum": 0, "maximum": 299, "default": 290 }
        ,"message_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "description": "Pages bounded terminal task-owned text with the offset and limit continuation contract. Questions from user-input requests are embedded in full in wait projections, not paged here.",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
        "offset": { "type": "integer", "minimum": 0, "default": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 262144, "default": 262144 }
      },
      "additionalProperties": false
    },
    "result_projection": {
      "type": "object",
      "required": ["outcome", "final_text", "partial", "offset", "total_bytes", "next_offset", "complete"],
      "properties": {
        "outcome": { "enum": ["COMPLETED", "FAILED", "CANCELLED", "TIMED_OUT", "RUNTIME_LOST", "RESULT_INVALID"] },
        "final_text": { "type": "string" },
        "partial": { "type": "boolean" },
        "offset": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "next_offset": { "type": ["integer", "null"], "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "question_projection": {
      "type": "object",
      "description": "Embedded question of an answerable user-input request in the wait projection's pending_requests entries; wait is the only retrieval surface, so a question beyond the embed cap is marked truncated instead of paged.",
      "required": ["text", "truncated"],
      "properties": {
        "text": { "type": "string" },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "error_projection": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "component": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
            "prompt_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external_subagent_status": { "input": [], "output": ["mcp_version", "components", "capabilities", "subagents"] },
        "external_subagent_spawn": { "input": ["subagent", "repository", "permission_mode", "prompt", "model", "effort", "write_manifest"], "output": ["agent_id", "status"], "idempotent": false },
        "external_subagent_wait": { "input": ["agent_id", "wait_time", "message_id"], "output": ["task", "pending_requests", "result_available", "activity", "result", "instruction", "timed_out", "message_receipt"] },
        "external_subagent_observe": { "input": ["agent_id"], "output": ["tools", "reasoning", "coverage"], "idempotent": true },
        "external_subagent_list": { "input": ["subagent", "repository", "phase", "outcome", "cursor", "limit"], "output": ["tasks", "next_cursor"] },
        "external_subagent_send": { "input": ["agent_id", "message_id", "content"], "output": ["message_id", "disposition"] },
        "external_subagent_respond": { "input": ["agent_id", "request_id", "decision", "content"], "output": ["disposition", "requested_decision", "effective_decision", "policy_overrode", "policy_reason_code"] },
        "external_subagent_cancel": { "input": ["agent_id"], "output": ["task"] },
        "external_subagent_result": { "input": ["agent_id", "offset", "limit"], "output": ["task", "result"] },
        "external_subagent_close": { "input": ["agent_id"], "output": ["task"] }
      }
    }
  },
  "additionalProperties": false
}
