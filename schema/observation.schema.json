{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "external-subagent suspicion-only observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tools",
    "reasoning",
    "coverage"
  ],
  "properties": {
    "tools": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_name",
          "call_count",
          "recent_calls"
        ],
        "properties": {
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "call_count": {
            "type": "integer",
            "minimum": 1
          },
          "recent_calls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seq",
                "tool_call_id",
                "arguments",
                "arguments_truncated",
                "redacted_fields",
                "status"
              ],
              "properties": {
                "seq": {
                  "type": "integer",
                  "minimum": 1
                },
                "tool_call_id": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "object"
                },
                "arguments_truncated": {
                  "type": "boolean"
                },
                "redacted_fields": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "unknown",
                    "pending",
                    "running",
                    "finished",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ],
                  "description": "Native phase/outcome evidence. unknown means no phase fact was observed; finished means the call ended without success/failure evidence; succeeded only comes from an explicit native fact."
                }
              }
            }
          }
        }
      }
    },
    "reasoning": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "text",
        "truncated"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "truncated": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "description": "Native protocol/channel that produced the exposed public reasoning. Absent when no public reasoning delta was observed; this is observation evidence, not a per-adapter capability promise.",
          "required": [
            "protocol",
            "channel"
          ],
          "properties": {
            "protocol": {
              "enum": [
                "codex_app_server",
                "zcode_session",
                "zcode_telemetry_v4",
                "dsh_acp_v1",
                "agy_stream_json",
                "runtime"
              ]
            },
            "channel": {
              "enum": [
                "summary",
                "thought"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_history_complete",
        "reasoning_complete",
        "dropped_events"
      ],
      "properties": {
        "tool_history_complete": {
          "type": "boolean"
        },
        "reasoning_complete": {
          "type": "boolean"
        },
        "dropped_events": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
