{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-subagent.invalid/schema/public-api.json",
  "title": "external-subagent MCP public API",
  "description": "The intentionally small external_subagent_* wire catalog.",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "const": ["external_subagent_cancel", "external_subagent_close", "external_subagent_list", "external_subagent_observe", "external_subagent_wait", "external_subagent_respond", "external_subagent_result", "external_subagent_send", "external_subagent_spawn", "external_subagent_status"]
    },
    "permission_mode": { "enum": ["build", "edit", "plan", "yolo"], "default": "build" },
    "agent_status": {
      "type": "object",
      "required": ["agent", "config_revision", "configured", "enabled", "spawn_supported", "transport_support", "permission_modes", "model_selection", "local", "auth", "hi"],
      "properties": {
        "agent": { "enum": ["zcode", "dsh"] },
        "config_revision": { "type": "integer", "minimum": 0 },
        "configured": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "spawn_supported": { "type": "boolean" },
        "transport_support": {
          "type": "object",
          "required": ["transport", "probe", "spawn"],
          "properties": {
            "transport": { "enum": ["zcode_app_server", "dsh_acp"] },
            "probe": { "type": "boolean" },
            "spawn": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "permission_modes": {
          "type": "array",
          "items": { "enum": ["build", "edit", "plan", "yolo"] },
          "uniqueItems": true
        },
        "model_selection": {
          "type": "object",
          "required": ["supported", "mode"],
          "properties": {
            "supported": { "type": "boolean" },
            "mode": { "enum": ["native_only", "catalog_token"] }
          },
          "additionalProperties": false
        },
        "local": { "$ref": "#/properties/agent_scope_status" },
        "auth": { "$ref": "#/properties/agent_scope_status" },
        "hi": { "$ref": "#/properties/agent_scope_status" }
      },
      "additionalProperties": false
    },
    "agent_scope_status": {
      "type": "object",
      "required": ["state", "scope"],
      "properties": {
        "state": { "enum": ["READY", "DEGRADED", "UNAVAILABLE", "UNKNOWN"] },
        "scope": {
          "type": "object",
          "properties": {
            "workspace": { "type": "string", "minLength": 1 },
            "home": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "version": { "type": "string", "minLength": 1 },
        "checked_at_ms": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "spawn": {
      "type": "object",
      "required": ["repository", "prompt"],
      "properties": {
        "agent": { "type": "string", "minLength": 1, "description": "Provider route key; omission uses configured default_agent or returns agent_required. Null is invalid; dsh production spawn remains gated." },
        "repository": { "type": "string", "minLength": 1 },
        "permission_mode": { "$ref": "#/properties/permission_mode" },
        "prompt": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "write_manifest": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "required": ["permission_mode"], "properties": { "permission_mode": { "const": "plan" } } },
          "then": { "properties": { "write_manifest": { "maxItems": 0 } } } }
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "phase": { "type": ["string", "null"], "default": null },
        "outcome": { "type": ["string", "null"], "default": null },
        "cursor": { "type": ["string", "null"], "default": null },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
      },
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "description": "Wait returns early only for a respondable pending request in the caller's declared capability scope (permission requests always; answerable user-input requests only with supports_answer=true) or a terminal result; ordinary progress, message receipts, and non-respondable requests never wake it. The pending_requests output projection is capped at 100 records, while the wake decision scans the full pending set and the request that woke the wait is always part of the returned projection. Each answerable user-input entry also embeds a bounded first question page; when its next_offset is set, page the remaining question content through the result tool with that request_id.",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
        "wait_time": { "type": "integer", "minimum": 0, "maximum": 299, "default": 290 }
        ,"message_id": { "type": ["string", "null"] }
        ,"supports_answer": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "description": "Pages bounded task-owned text with the shared offset and limit continuation contract. Without request_id it reads the terminal task result; with request_id it pages the stored question of that pending user-input request, so content beyond the bounded wait-projection question page stays recoverable.",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
        "request_id": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0, "default": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 262144, "default": 262144 }
      },
      "additionalProperties": false
    },
    "result_projection": {
      "type": "object",
      "required": ["outcome", "final_text", "partial", "offset", "total_bytes", "next_offset", "complete"],
      "properties": {
        "outcome": { "enum": ["COMPLETED", "FAILED", "CANCELLED", "TIMED_OUT", "RUNTIME_LOST", "RESULT_INVALID"] },
        "final_text": { "type": "string" },
        "partial": { "type": "boolean" },
        "offset": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "next_offset": { "type": ["integer", "null"], "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "question_projection": {
      "type": "object",
      "description": "Bounded recoverable page of an answerable user-input question, embedded as the first page in the wait projection's pending_requests entries and continued through the result tool with that request_id.",
      "required": ["text", "offset", "total_bytes", "next_offset", "complete"],
      "properties": {
        "text": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "next_offset": { "type": ["integer", "null"], "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "error_projection": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "component": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
            "cleanup": { "type": "string", "minLength": 1 },
            "prompt_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external_subagent_status": { "input": [], "output": ["mcp_version", "components", "capabilities", "agents", "identity"] },
        "external_subagent_spawn": { "input": ["agent", "repository", "permission_mode", "prompt", "model", "write_manifest"], "output": ["agent_id", "submission_disposition", "phase"], "idempotent": false },
        "external_subagent_wait": { "input": ["agent_id", "wait_time", "message_id", "supports_answer"], "output": ["task", "pending_requests", "result_available", "activity", "latest_progress", "result", "instruction", "timed_out", "message_receipt"] },
        "external_subagent_observe": { "input": ["agent_id"], "output": ["tools", "reasoning", "coverage"], "idempotent": true },
        "external_subagent_list": { "input": ["agent", "repository", "phase", "outcome", "cursor", "limit"], "output": ["tasks", "next_cursor"] },
        "external_subagent_send": { "input": ["agent_id", "message_id", "content"], "output": ["message_id", "disposition"] },
        "external_subagent_respond": { "input": ["agent_id", "request_id", "decision", "content"], "output": ["disposition", "requested_decision", "effective_decision", "policy_overrode", "policy_reason_code"] },
        "external_subagent_cancel": { "input": ["agent_id"], "output": ["task"] },
        "external_subagent_result": { "input": ["agent_id", "request_id", "offset", "limit"], "output": ["task", "result", "question"] },
        "external_subagent_close": { "input": ["agent_id"], "output": ["task"] }
      }
    }
  },
  "additionalProperties": false
}
