{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-subagent.invalid/schema/public-api.json",
  "title": "external-subagent MCP public API",
  "description": "The intentionally small external_subagent_* wire catalog.",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "const": ["external_subagent_cancel", "external_subagent_close", "external_subagent_list", "external_subagent_observe", "external_subagent_wait", "external_subagent_respond", "external_subagent_result", "external_subagent_send", "external_subagent_spawn", "external_subagent_status"]
    },
    "permission_mode": { "enum": ["build", "edit", "plan", "yolo"], "default": "build" },
    "spawn": {
      "type": "object",
      "required": ["agent", "repository", "prompt"],
      "properties": {
        "agent": { "enum": ["zcode", "dsh"] },
        "repository": { "type": "string", "minLength": 1 },
        "permission_mode": { "$ref": "#/properties/permission_mode" },
        "prompt": { "type": "string", "minLength": 1 },
        "write_manifest": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "required": ["permission_mode"], "properties": { "permission_mode": { "const": "plan" } } },
          "then": { "properties": { "write_manifest": { "maxItems": 0 } } } }
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "phase": { "type": ["string", "null"], "default": null },
        "outcome": { "type": ["string", "null"], "default": null },
        "cursor": { "type": ["string", "null"], "default": null },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
      },
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "description": "Wait returns on terminal completion or any request in the ordered pending_requests projection whose state is pending and respondable is true, regardless of tool kind or name. The projection is capped at 100 records; a qualifying request outside that projection does not wake this wait.",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
        "after_revision": { "type": "integer", "minimum": 0, "default": 0 },
        "wait_time": { "type": "integer", "minimum": 0, "maximum": 299, "default": 290 }
        ,"message_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
        "offset": { "type": "integer", "minimum": 0, "default": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 262144, "default": 262144 }
      },
      "additionalProperties": false
    },
    "result_projection": {
      "type": "object",
      "required": ["outcome", "final_text", "partial", "offset", "total_bytes", "next_offset", "complete"],
      "properties": {
        "outcome": { "enum": ["COMPLETED", "FAILED", "CANCELLED", "TIMED_OUT", "RUNTIME_LOST", "RESULT_INVALID"] },
        "final_text": { "type": "string" },
        "partial": { "type": "boolean" },
        "offset": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "next_offset": { "type": ["integer", "null"], "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "error_projection": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "component": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "integer", "minimum": 10000000, "maximum": 99999999 },
            "cleanup": { "type": "string", "minLength": 1 },
            "prompt_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external_subagent_status": { "input": [], "output": ["components", "capabilities", "identity"] },
        "external_subagent_spawn": { "input": ["repository", "permission_mode", "prompt", "write_manifest"], "output": ["agent_id", "submission_disposition", "phase"], "idempotent": false },
        "external_subagent_wait": { "input": ["agent_id", "after_revision", "wait_time", "message_id"], "output": ["task", "revision", "next_revision", "pending_requests", "command_pending_approval", "result_available", "activity", "latest_progress", "result", "instruction", "timed_out", "message_receipt"] },
        "external_subagent_observe": { "input": ["agent_id"], "output": ["tools", "reasoning", "coverage"], "idempotent": true },
        "external_subagent_list": { "input": ["repository", "phase", "outcome", "cursor", "limit"], "output": ["tasks", "next_cursor"] },
        "external_subagent_send": { "input": ["agent_id", "message_id", "content"], "output": ["message_id", "disposition"] },
        "external_subagent_respond": { "input": ["agent_id", "request_id", "decision", "reason"], "output": ["disposition", "requested_decision", "effective_decision", "policy_overrode", "policy_reason_code"] },
        "external_subagent_cancel": { "input": ["agent_id"], "output": ["task"] },
        "external_subagent_result": { "input": ["agent_id", "offset", "limit"], "output": ["task", "result"] },
        "external_subagent_close": { "input": ["agent_id"], "output": ["task"] }
      }
    }
  },
  "additionalProperties": false
}
